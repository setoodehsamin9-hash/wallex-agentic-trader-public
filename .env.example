# Copy to .env (never committed) and fill in on the machine that runs the agent.
# Values here are placeholders. Do not paste real keys into chat, issues, prompts or logs.

# --- Wallex ---
# API key of the CHALLENGE SUB-ACCOUNT only (each credit sub-account has its own key).
# Create it without withdrawal permission and restrict allowed IPs if Wallex offers it.
# Required only for SHADOW (private fee/balance reads) and LIVE. Leave empty for BACKTEST.
WALLEX_API_KEY=
WALLEX_REST_BASE_URL=https://api.wallex.ir
WALLEX_MCP_URL=https://api.wallex.ir/mcp

# --- LLM: NineRouter only (OpenAI-compatible router running on the owner's machine) ---
# Never call providers directly. Put the key in a file OUTSIDE this repository and point to it,
# or export NINEROUTER_API_KEY in the shell. Never paste the key here.
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY_FILE=/absolute/path/outside/repo/ninerouter_key.txt
# Model id as listed by GET $NINEROUTER_BASE_URL/models (configurable; not hard-coded in code)
NINEROUTER_MODEL=av/claude-sonnet-5-5
NINEROUTER_TIMEOUT_S=45

# --- Runtime ---
# Path to the run config (autonomy, environment, risk limits). See config/ (Phase 03).
WALLEX_AGENT_CONFIG=config/shadow.toml
# Where journals, ledgers and recorded model/tool payloads are written (git-ignored).
WALLEX_AGENT_STATE_DIR=var/
# Silence PydanticAI's observability banner; no telemetry exporter is configured by default.
PYDANTIC_AI_NO_BANNER=1
